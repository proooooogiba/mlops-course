    {
      "id": 4,
      "title": "Распределение записанных скоров во времени",
      "description": "",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(fraud_db_score_bucket[30s]))",
          "legendFormat": "{{le}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "heatmap"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
