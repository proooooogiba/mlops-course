        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "scores-postgres"
        },
        "query": "SELECT DISTINCT merch AS __text, merch AS __value FROM scores WHERE us_state IN (${state:sqlstring}) ORDER BY 1",
