          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "state",
        "label": "Штат",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "scores-postgres"
        },
        "query": "SELECT DISTINCT us_state AS __text, us_state AS __value FROM scores ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all",
