    {
      "id": 5,
      "title": "Скоры и доля фрода по версии модели",
      "description": "PostgreSQL: сохраненные результаты за выбранный интервал; fraud_share — доля предсказанных фродов.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "scores-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT model_version, count(*) AS scores, avg(fraud_flag)::float AS fraud_share FROM scores WHERE $__timeFilter(written_at) GROUP BY model_version ORDER BY model_version",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "scores-postgres"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "TPS по выбранным штатам и мерчантам",
      "description": "Скорость обработки по времени scored_at, зафиксированному сервисом скоринга.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "scores-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT $__timeGroupAlias(scored_at, '10s'), count(*) / 10.0 AS tps FROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${state:sqlstring}) AND merch IN (${merchant:sqlstring}) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "scores-postgres"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Плотность скоров: выбранные штаты и мерчанты",
      "description": "Интервалы шириной 0.05. Высота — плотность: сумма высот × 0.05 = 1.",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "scores-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT (floor(least(score, 0.999999) * 20) / 20)::text AS score_bucket, count(*) / (sum(count(*)) OVER () * 0.05)::float AS density FROM scores WHERE $__timeFilter(written_at) AND us_state IN (${state:sqlstring}) AND merch IN (${merchant:sqlstring}) GROUP BY floor(least(score, 0.999999) * 20) ORDER BY floor(least(score, 0.999999) * 20)",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "scores-postgres"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "score_bucket",
        "orientation": "auto",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "title": "Доля фрода по категориям: последние 1000",
      "description": "Последние 1000 сохраненных операций всего потока; фильтры штата/мерчанта к этой панели не применяются.",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "scores-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "WITH recent AS (SELECT cat_id, fraud_flag FROM scores ORDER BY written_at DESC, transaction_id DESC LIMIT 1000) SELECT cat_id, avg(fraud_flag)::float AS fraud_share FROM recent GROUP BY cat_id ORDER BY fraud_share DESC",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "scores-postgres"
          }
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "cat_id",
        "orientation": "horizontal",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "Сумма операций с флагом фрода по штатам",
      "description": "Бизнес-панель: где сосредоточена сумма подозрительных операций. Используется предсказанный флаг, не подтвержденная разметка.",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "scores-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT us_state, sum(amount * fraud_flag)::float AS flagged_amount FROM scores WHERE $__timeFilter(written_at) GROUP BY us_state ORDER BY flagged_amount DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "postgres",
            "uid": "scores-postgres"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "us_state",
        "orientation": "auto",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "title": "Повторные доставки и ошибки записи",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
